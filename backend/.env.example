CRICKET_API_KEY=
CRICKET_API_POLL_INTERVAL_MS=900000

# Optional dashboard section sizes (defaults: 5, capped at 50)
# DASHBOARD_RECENT_LIMIT=5
# DASHBOARD_UPCOMING_LIMIT=5

# Comma-separated allowed CORS origins (defaults to localhost:5173,
# 127.0.0.1:5173 and https://criclyst.vercel.app when unset)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://criclyst.vercel.app

# Redis (used for token blacklisting and rate limiting)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis URL (preferred — overrides REDIS_HOST/REDIS_PORT for Pub/Sub)
# REDIS_URL=redis://localhost:6379
